[Desktop Entry]
Type=Application
Name=Fresh Fan Manager
GenericName=Fan & Temperature Monitor
Comment=Monitor temperatura, ventola e CPU/GPU per MacBook su Linux
Exec=/usr/local/bin/fresh-fan-manager --widget
Icon=fresh-fan-manager
Terminal=false
Categories=System;Monitor;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=panel
